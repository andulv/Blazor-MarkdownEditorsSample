@page "/editors/cherrydown"
@rendermode InteractiveServer
@inject FileBrowserService FileBrowserService

<PageTitle>Cherrydown Test</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">Cherrydown Editor Test</MudText>
<MarkdownEditorInfoPanel
    ComponentName="Cherry Markdown (local wrapper)"
    HomepageUrl="https://tencent.github.io/cherry-markdown/"
    Version="0.10.3"
    DocsUrl="https://tencent.github.io/cherry-markdown/examples/index.html"
    SamplesUrl="https://github.com/Tencent/cherry-markdown/tree/master/examples"
    TutorialUrl="https://github.com/Tencent/cherry-markdown"
    Notes="Custom Blazor wrapper in MarkdownEditorsSample.Blazor." />
<MudGrid>
    <MudItem xs="12" md="4">
        <RepositoryFileBrowser SelectedPath="_selectedPath" SelectedPathChanged="OnSelectedPathChanged" />
    </MudItem>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-3 editor-pane">
            <MudText Typo="Typo.subtitle1">@(_selectedPath ?? "(select a file)")</MudText>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_error</MudAlert>
            }
            else if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="mt-2" />
            }
            else if (string.IsNullOrWhiteSpace(_content))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Select a markdown/text file to edit.</MudText>
            }
            else
            {
                <div class="mt-2 editor-host">
                    <CherryMarkdownEditor Value="@_content" ValueChanged="OnEditorChanged" HeightPx="520" />
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string? _selectedPath;
    private string? _content;
    private bool _isLoading;
    private string? _error;

    private Task OnEditorChanged(string? newValue)
    {
        _content = newValue;
        return Task.CompletedTask;
    }

    private async Task OnSelectedPathChanged(string? path)
    {
        _selectedPath = path;
        _error = null;

        if (string.IsNullOrWhiteSpace(path))
        {
            _content = null;
            return;
        }

        try
        {
            _isLoading = true;
            _content = await FileBrowserService.ReadFileAsync(path);
        }
        catch (Exception ex)
        {
            _content = null;
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
