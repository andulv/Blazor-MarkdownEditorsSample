@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div id="@_editorId" @ref="_hostElement"></div>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public int HeightPx { get; set; } = 520;

    private readonly string _editorId = $"toast-{Guid.NewGuid():N}";
    private DotNetObjectReference<ToastUiMarkdownEditor>? _dotNetRef;
    private IJSObjectReference? _module;
    private ElementReference _hostElement;
    private string _lastAppliedValue = string.Empty;
    private bool _isInitialized;
    private bool _isApplyingFromJs;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/ToastUiMarkdownEditor.razor.js");
        _dotNetRef = DotNetObjectReference.Create(this);

        _lastAppliedValue = Value ?? string.Empty;

        await _module.InvokeVoidAsync(
            "initToastEditor",
            _hostElement,
            _editorId,
            _dotNetRef,
            _lastAppliedValue,
            HeightPx);

        _isInitialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isInitialized || _module is null || _isApplyingFromJs)
            return;

        var incomingValue = Value ?? string.Empty;
        if (incomingValue == _lastAppliedValue)
            return;

        _lastAppliedValue = incomingValue;
        await _module.InvokeVoidAsync("setToastMarkdown", _hostElement, incomingValue);
    }

    [JSInvokable]
    public async Task OnEditorChanged(string markdown)
    {
        _isApplyingFromJs = true;
        try
        {
            _lastAppliedValue = markdown;
            if (ValueChanged.HasDelegate)
                await ValueChanged.InvokeAsync(markdown);
        }
        finally
        {
            _isApplyingFromJs = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disposeToastEditor", _hostElement);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit ended; client-side cleanup is no longer available.
            }
        }

        _dotNetRef?.Dispose();
    }
}
