{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C#: MarkdownEditorsSample.Blazor Debug",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/MarkdownEditorsSample.Blazor/bin/Debug/net10.0/MarkdownEditorsSample.Blazor.dll",
      "cwd": "${workspaceFolder}/src/MarkdownEditorsSample.Blazor",
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "preLaunchTask": "build MarkdownEditorsSample.Blazor",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
