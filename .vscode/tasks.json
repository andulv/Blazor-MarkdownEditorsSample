{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build Blazor-MarkdownEditorsSample",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/Blazor-MarkdownEditorsSample.slnx"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "build MarkdownEditorsSample.Blazor",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/src/MarkdownEditorsSample.Blazor/MarkdownEditorsSample.Blazor.csproj"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "run MarkdownEditorsSample.Blazor",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"${workspaceFolder}/src/MarkdownEditorsSample.Blazor/MarkdownEditorsSample.Blazor.csproj"
			],
			"isBackground": true,
			"problemMatcher": [
				"$msCompile"
			]
		}
	]
}